# Copy this file to `.env` and fill in any keys you have.
# All keys are OPTIONAL for Phase 1 — the pipeline works without them.

# --- Binance ---
# Only needed if you later want authenticated endpoints (account info, orders).
# Public market data (klines, WS) requires NO key.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- News ---
# CryptoPanic free tier works without a key but is rate-limited.
# Get a free key at https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# NewsAPI.org — optional, broader coverage but not crypto-specific.
# Free tier: 100 req/day.
NEWSAPI_KEY=
